# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Job sources: the Tier A and Tier B sources in docs/SOURCES.md are public
# and keyless, so no source credentials are needed. Any source added later
# that requires a key gets its variable here.

# Sentry — read by the SDK directly (EM-22). Leave empty to run without it;
# the SDK then stays disabled and logs a single warning at start. Inside the
# Dev Container the DSN's ingest host (the `*.ingest.sentry.io` or
# `*.ingest.de.sentry.io` part of it) must also be in init-firewall.sh's
# allowlist, or events are dropped silently.
SENTRY_DSN=

# Database — matches the Dev Container's docker-compose defaults.
# Override the host when running outside the container.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=employme;Username=postgres;Password=postgres

# Ollama — matches the Dev Container's docker-compose defaults.
Ollama__BaseUrl=http://localhost:11434
