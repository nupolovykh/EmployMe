{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=employme;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Ingest": {
    "MaxPagesPerSource": 5,
    "Scheduler": {
      "Enabled": true,
      "Interval": "00:15:00",
      "StartupDelay": "00:00:30"
    }
  }
}
